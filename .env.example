NODE_ENV=development
PORT=3000

AUTH_SERVICE_URL=http://localhost:3001
ROOM_SERVICE_URL=http://localhost:3003
MESSAGE_SERVICE_URL=http://localhost:3004
USER_CONFIG_SERVICE_URL=http://localhost:3005

PROXY_TIMEOUT_MS=5000
MAX_PROXY_BODY_BYTES=1048576

# Limitation locale du point d'entrée Auth (par IP et par route).
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Liste d'origines séparées par des virgules. "null" peut être ajouté
# explicitement si une version packagée Electron en a besoin.
CORS_ORIGINS=http://localhost:5173

# Mettre à true uniquement derrière un reverse proxy de confiance.
TRUST_PROXY=false
